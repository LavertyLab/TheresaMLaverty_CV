@article{kola-olusanya_role_2023,
	title = {Role of environmental education in water pollution prevention and conservation in {Nigeria}},
	volume = {24},
	issn = {1606-9749},
	url = {https://doi.org/10.2166/ws.2023.337},
	doi = {10.2166/ws.2023.337},
	abstract = {Water-related issues such as scarcity and pollution have become increasingly pressing in sub-Saharan Africa, especially Nigeria, highlighting the need for an effective environmental education (EE) programme. The relationship between EE and water pollution prevention and conservation in Nigeria remains an open question. Therefore, this study aimed to assess the role of EE in water pollution prevention and conservation in Nigeria. A simple random sampling was used to select 766 respondents from the southwest geo-political zone of Nigeria. Data were analyzed using simple descriptive statistics and analysis of variance. Results show a high level of awareness of water pollution and conservation strategies. However, people's attitude towards preventing water pollution and conservation was poor. Age does not significantly (at p \&lt; 0.05) affect awareness and attitude towards water pollution prevention and conservation. However, the level of education significantly (at p \&lt; 0.05) influences the level of awareness and attitude of people towards water pollution prevention and conservation. EE increases awareness and attitude towards water pollution prevention and conservation. Therefore, the Federal Ministries of Water Resources and Education should endeavour to make EE a compulsory programme in the school curriculum across all levels of education.},
	number = {2},
	urldate = {2026-04-23},
	journal = {Water Supply},
	author = {Kola-Olusanya, Anthony and Oyeyemi, Ezekiel and Adewale, Peter Sanjo and Omobuwa, Olubukunola},
	month = dec,
	year = {2023},
	pages = {361--370},
}

