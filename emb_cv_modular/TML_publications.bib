@article{patrick_value_1994,
	title = {The {Value} of {Species} as {Indicators} of {Water} {Quality}},
	volume = {145},
	issn = {0097-3157},
	url = {http://www.jstor.org/stable/4064985},
	doi = {10.2307/4064985},
	abstract = {This study was undertaken to determine whether the Clean Water Act had been effective in improving the biological and chemical conditions of the Delaware and Neches Estuaries and the Flint River. A review of the literature indicated that the effort spent and methods varied so much that there were no firm bases by which one could compare changes over time based on numbers of species and relative abundance. Therefore, the autoecologies of the species were used to determine the ratio of pollution tolerant species to those characteristic of natural water as a basis for determining change. A thorough study of the literature has produced the list of species found and their pollution tolerance. This list should be of use to others studying the effects of pollution on fresh and brackish water ecosystems.},
