@article{webster_links_2002,
	title = {Links between worlds: unraveling migratory connectivity},
	volume = {17},
	issn = {0169-5347},
	url = {https://www.sciencedirect.com/science/article/pii/S0169534701023801},
	doi = {https://doi.org/10.1016/S0169-5347(01)02380-1},
	abstract = {Migration is the regular seasonal movement of animals from one place to another, often from a breeding site to a nonbreeding site and back. Because the act of migration makes it difficult to follow individuals and populations year round, our understanding of the ecology and evolution of migrating organisms, particularly birds, has been severely impeded. Exciting new advances in satellite telemetry, genetic analyses and stable isotope chemistry are now making it possible to determine the population and geographical origin of individual birds. Here, we review these new approaches and consider the relevance of understanding migratory connectivity to ecological, evolutionary and conservation issues.},
	number = {2},
	journal = {Trends in Ecology \& Evolution},
	author = {Webster, Michael S. and Marra, Peter P. and Haig, Susan M. and Bensch, Staffan and Holmes, Richard T.},
	year = {2002},
	keywords = {conservation, Connectivity, Genetic Markers, Isotopes, Migration, Migratory Birds, ornithology, Satellite, Telemetry},
	pages = {76--83},
}

@article{rubenstein_birds_2004,
	title = {From birds to butterflies: animal movement patterns and stable isotopes},
	volume = {19},
	issn = {0169-5347},
	url = {https://www.sciencedirect.com/science/article/pii/S0169534704000722},
	doi = {https://doi.org/10.1016/j.tree.2004.03.017},
	abstract = {Establishing patterns of movement of wild animals is crucial for our understanding of their ecology, life history and behavior, and is a prerequisite for their effective conservation. Advances in the use of stable isotope markers make it possible to track a diversity of animal species in a variety of habitats. This approach is revolutionizing the way in which we make connections between phases of the annual cycle of migratory animals. However, researchers must exercise care in their application of isotopic methods. Here, we review stable isotope patterns in nature and discuss recent tracking applications in a range of taxa. To aid in the interpretation and design of effective and insightful isotope movement studies, we discuss a series of key issues and assumptions. This exciting field will advance rapidly if researchers consider these aspects of study design and interpretation carefully.},
	number = {5},
	journal = {Trends in Ecology \& Evolution},
	author = {Rubenstein, Dustin R. and Hobson, Keith A.},
	year = {2004},
	pages = {256--263},
}

